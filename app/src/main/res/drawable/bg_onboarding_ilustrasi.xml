<?xml version="1.0" encoding="utf-8"?>
<!-- Ilustrasi onboarding: lingkaran luar lembut + lingkaran dalam putih (ikon di tengahnya) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/warnaUtamaLembut" />
        </shape>
    </item>
    <item
        android:bottom="36dp"
        android:left="36dp"
        android:right="36dp"
        android:top="36dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>
