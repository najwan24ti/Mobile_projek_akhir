<?xml version="1.0" encoding="utf-8"?>
<!-- Background halaman: krem + beberapa cahaya warna samar.
     Cahaya ini yang terlihat buram lewat card kaca (KacaDrawable). Warnanya ikut tema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/palm_cream" />
        </shape>
    </item>

    <!-- Gradasi lembut di atas -->
    <item
        android:height="300dp"
        android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/palm_cream"
                android:startColor="?attr/warnaUtamaLembut" />
        </shape>
    </item>

    <!-- Cahaya kanan atas -->
    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="top|end"
        android:right="-120dp"
        android:top="60dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFFFFF"
                android:gradientRadius="160dp"
                android:startColor="?attr/warnaCahayaLatar"
                android:type="radial" />
        </shape>
    </item>

    <!-- Cahaya emas kiri tengah -->
    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="center_vertical|start"
        android:left="-130dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFFFFF"
                android:gradientRadius="150dp"
                android:startColor="@color/cahaya_emas"
                android:type="radial" />
        </shape>
    </item>

    <!-- Cahaya kanan bawah -->
    <item
        android:width="340dp"
        android:height="340dp"
        android:bottom="-60dp"
        android:gravity="bottom|end"
        android:right="-110dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFFFFF"
                android:gradientRadius="170dp"
                android:startColor="?attr/warnaCahayaLatar"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
