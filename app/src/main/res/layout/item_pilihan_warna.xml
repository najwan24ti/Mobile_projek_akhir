<?xml version="1.0" encoding="utf-8"?>
<!-- Satu pilihan warna tema: lingkaran warna + nama warna -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <FrameLayout
        android:id="@+id/cincin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="5dp">

        <View
            android:id="@+id/lingkaran"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lingkaran"
            tools:backgroundTint="@color/tema_merah" />

        <ImageView
            android:id="@+id/imgCentang"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtNama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/palm_text_muted"
        android:textSize="12sp"
        tools:text="Merah" />
</LinearLayout>
