<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris menu di halaman Profil: ikon, label, nilai (opsional), lalu panah atau saklar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/imgIkon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_tile"
        android:importantForAccessibility="no"
        android:padding="8dp"
        tools:backgroundTint="@color/tile_peach_bg"
        tools:src="@drawable/ic_edit"
        tools:tint="@color/tile_peach" />

    <TextView
        android:id="@+id/txtLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:textColor="@color/palm_text"
        android:textSize="14sp"
        tools:text="Edit profil" />

    <TextView
        android:id="@+id/txtNilai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/palm_text_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="v1.0"
        tools:visibility="visible" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/saklar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgPanah"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/palm_text_muted" />
</LinearLayout>
