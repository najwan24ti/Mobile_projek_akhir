<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palm_cream"
    android:orientation="vertical"
    tools:context=".palmsys.penjualan.CatatPenjualanActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/palm_cream"
        app:menu="@menu/menu_catat_penjualan"
        app:navigationContentDescription="@string/batal"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/palm_text"
        app:title="@string/penjualan_judul"
        app:titleTextColor="@color/palm_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- Banner offline -->
            <LinearLayout
                android:id="@+id/bannerOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_banner_offline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cloud_off"
                    app:tint="?attr/warnaUtama" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/penjualan_offline"
                    android:textColor="?attr/warnaUtamaGelap"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tanggal panen -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/penjualan_tanggal"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/palm_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/palm_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Blok -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/penjualan_blok"
                android:textColor="@color/palm_text_muted"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipBlok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBlokA"
                    style="@style/Widget.PalmSys.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/penjualan_blok_a" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBlokB"
                    style="@style/Widget.PalmSys.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/penjualan_blok_b" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBlokC"
                    style="@style/Widget.PalmSys.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/penjualan_blok_c" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Berat bruto & sortasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBruto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.6"
                    android:hint="@string/penjualan_bruto"
                    app:suffixText="@string/satuan_kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputBruto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="7"
                        android:textColor="@color/palm_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSortasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/penjualan_sortasi"
                    app:suffixText="@string/satuan_persen">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputSortasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLength="4"
                        android:textColor="@color/palm_text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Harga & pembeli -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutHarga"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/penjualan_harga"
                    app:prefixText="@string/awalan_rp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputHarga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textColor="@color/palm_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPembeli"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/penjualan_pembeli">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPembeli"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/palm_text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Foto nota -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/penjualan_foto"
                android:textColor="@color/palm_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgNota"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/penjualan_foto"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium" />

                <LinearLayout
                    android:id="@+id/btnTambahFoto"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_tambah_foto"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_camera"
                        app:tint="?attr/warnaUtama" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/penjualan_foto_tambah"
                        android:textColor="?attr/warnaUtamaGelap"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:text="@string/penjualan_foto_info"
                    android:textColor="@color/palm_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Ringkasan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_ringkasan"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtBeratBersihLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/palm_text_muted"
                        android:textSize="13sp"
                        tools:text="Berat bersih (−2%)" />

                    <TextView
                        android:id="@+id/txtBeratBersih"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/palm_text"
                        android:textSize="13sp"
                        tools:text="2.587 kg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtRumus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/palm_text_muted"
                        android:textSize="13sp"
                        tools:text="2.587 kg × Rp 3.250" />

                    <TextView
                        android:id="@+id/txtSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/palm_text"
                        android:textSize="13sp"
                        tools:text="Rp 8.407.750" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/palm_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/penjualan_total"
                        android:textColor="@color/palm_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/warnaUtamaGelap"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Rp 8.407.750" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:backgroundTint="?attr/warnaUtamaGelap"
        android:text="@string/penjualan_simpan"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_check_circle"
        app:iconGravity="textStart"
        app:iconTint="@color/white" />
</LinearLayout>
