<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palm_cream"
    android:orientation="vertical"
    tools:context=".palmsys.pengaturan.PengaturanActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/palm_cream"
        app:navigationContentDescription="@string/kembali"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/palm_text"
        app:title="@string/pengaturan_judul"
        app:titleTextColor="@color/palm_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Pratinjau: kartu ini memakai warna tema, jadi langsung kelihatan hasilnya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_saldo_card"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_lingkaran"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_palette"
                    app:tint="?attr/warnaUtamaGelap" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:text="@string/pengaturan_tema_aktif"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtTemaAktif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Oranye" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pilihan warna tema -->
            <TextView
                style="@style/PalmSysJudulBagian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pengaturan_bagian_warna" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_kartu"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/daftarWarna"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/pengaturan_warna_info"
                    android:textColor="@color/palm_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Notifikasi & data -->
            <TextView
                style="@style/PalmSysJudulBagian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pengaturan_bagian_umum" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_kartu"
                android:divider="@drawable/garis_pemisah"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:showDividers="middle">

                <include
                    android:id="@+id/menuNotifikasi"
                    layout="@layout/item_menu_profil" />

                <include
                    android:id="@+id/menuSinkron"
                    layout="@layout/item_menu_profil" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
