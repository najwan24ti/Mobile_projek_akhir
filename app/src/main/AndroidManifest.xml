<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Untuk mengecek sinyal di halaman Catat Penjualan -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Najwan_2Tif">

        <!-- 0. Onboarding (dibuka pertama kali; kalau sudah pernah dilihat langsung ke Login) -->
        <activity
            android:name=".palmsys.onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.PalmSys">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1. Login -->
        <activity
            android:name=".palmsys.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys"
            android:windowSoftInputMode="adjustResize" />

        <!-- 1b. Daftar / registrasi akun (dari tombol Daftar di Login) -->
        <activity
            android:name=".palmsys.auth.DaftarActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2. Beranda -->
        <activity
            android:name=".palmsys.beranda.BerandaActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys" />

        <!-- 3. Catat Penjualan TBS -->
        <activity
            android:name=".palmsys.penjualan.CatatPenjualanActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3b. Semua Transaksi (ListView + CustomAdapter) -->
        <activity
            android:name=".palmsys.transaksi.TransaksiActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys" />

        <!-- 4. Profil (dari tab Profil di navigasi bawah) -->
        <activity
            android:name=".palmsys.profil.ProfilActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys" />

        <!-- 5. Pengaturan (warna tema, notifikasi) — dari halaman Profil -->
        <activity
            android:name=".palmsys.pengaturan.PengaturanActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys" />
    </application>

</manifest>
