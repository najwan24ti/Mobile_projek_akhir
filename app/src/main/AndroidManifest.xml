<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Untuk mengecek sinyal di halaman Catat Penjualan -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Najwan_2Tif">

        <!-- 1. Login -->
        <activity
            android:name=".palmsys.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.PalmSys"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Beranda -->
        <activity
            android:name=".palmsys.beranda.BerandaActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys" />

        <!-- 3. Catat Penjualan TBS -->
        <activity
            android:name=".palmsys.penjualan.CatatPenjualanActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Profil (dari tab Profil di navigasi bawah) -->
        <activity
            android:name=".palmsys.profil.ProfilActivity"
            android:exported="false"
            android:theme="@style/Theme.PalmSys" />
    </application>

</manifest>
